# --- Anker account (used by anker-driver to open the cloud MQTT session) ---
ANKER_EMAIL=you@example.com
ANKER_PASSWORD=changeme
ANKER_COUNTRY=JP
# Comma-separated serials to expose. Leave empty to auto-register every
# bound PPS-family device on the account.
ANKER_DEVICE_SNS=

# --- soltrk control loop ---
# Priority order for sequential charging, highest priority first.
# Must be a subset of ANKER_DEVICE_SNS (or of your full device list if that's empty).
ANKER_PRIORITY_SNS=SN_UNIT_1,SN_UNIT_2,SN_UNIT_3
POLL_INTERVAL_MS=15000
MIN_SOLAR_TO_CHARGE_WATTS=150
STATE_FILE_PATH=./data/state.json

# --- GTB-800 #1 (Tuya local) ---
TUYA_DEVICE_1_NAME=gtb800-1
TUYA_DEVICE_1_ID=
TUYA_DEVICE_1_KEY=
TUYA_DEVICE_1_IP=
# Confirm these two with `docker compose run --rm soltrk node dist/tuya/discover.js <id> <key> <ip>`
TUYA_DEVICE_1_POWER_DP=19
TUYA_DEVICE_1_POWER_SCALE=10

# --- GTB-800 #2 (Tuya local) ---
TUYA_DEVICE_2_NAME=gtb800-2
TUYA_DEVICE_2_ID=
TUYA_DEVICE_2_KEY=
TUYA_DEVICE_2_IP=
TUYA_DEVICE_2_POWER_DP=19
TUYA_DEVICE_2_POWER_SCALE=10
