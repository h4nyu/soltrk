{
  "name": "soltrk",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/src/index.js",
    "dev": "tsx watch packages/cli/src/index.ts run",
    "test": "find . -name '*.test.ts' -not -path '*/node_modules/*' | xargs tsx --test"
  },
  "dependencies": {
    "@soltrk/core": "*",
    "@soltrk/anker": "*",
    "@soltrk/tuya": "*",
    "@soltrk/cli": "*",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
